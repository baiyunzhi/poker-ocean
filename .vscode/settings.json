{
    // Python 配置
    "python.defaultInterpreterPath": "${userHome}\\.local\\bin\\python3.11.exe",
    "python.terminal.activateEnvironment": false,

    // 编辑器
    "editor.fontSize": 14,
    "editor.fontFamily": "'Cascadia Code', 'JetBrains Mono', 'Fira Code', Consolas, monospace",
    "editor.minimap.enabled": true,
    "editor.renderWhitespace": "selection",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.wordWrap": "off",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },

    // 文件
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true
    },

    // 终端
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.profiles.windows": {
        "Git Bash": {
            "path": "C:\\Program Files\\Git\\bin\\bash.exe"
        }
    },

    // Python 语言服务
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "ms-python.python"
    },

    // HTML/CSS/JS
    "[html]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[javascript]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // Claude Code
    "claudeCode.autoOpenInEditor": true,
    "claudeCode.statusBarEnabled": true,

    // 大纲视图显示符号
    "outline.showVariables": true,
    "outline.showFunctions": true,
    "outline.showClasses": true
}
